{
  "name": "nimsuper",
  "version": "0.2.0",
  "description": "Multi-provider API key rotator & fallback plugin for OpenCode — NVIDIA NIM, Google Gemini & Google Cloud Code Antigravity with live quota tracking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "nimsuper": "bin/nimsuper.js"
  },
  "scripts": {
    "build": "tsc",
    "tui": "bun run bin/nimsuper.ts",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "uninstall": "node scripts/uninstall.js",
    "format": "prettier -w ."
  },
  "keywords": [
    "opencode",
    "plugin",
    "nvidia",
    "nim",
    "nimsuper",
    "api-key",
    "rotation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinaverma97/nimsuper.git"
  },
  "bugs": {
    "url": "https://github.com/abhinaverma97/nimsuper/issues"
  },
  "homepage": "https://github.com/abhinaverma97/nimsuper#readme",
  "author": "abhinaverma97",
  "license": "MIT",
  "files": [
    "dist",
    "bin",
    "scripts"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.11",
    "@opentui/core": "^0.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "bun": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
